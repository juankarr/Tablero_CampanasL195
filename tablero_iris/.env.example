# Copia este archivo a ".env" y ajusta los valores.
# El archivo ".env" NUNCA debe subirse a un repositorio compartido.

# Usuario y contraseña de acceso al panel. Si IRIS_PASSWORD se deja vacía,
# el panel NO pide login (útil solo para probar en tu propio computador).
IRIS_USUARIO=SGAM195
IRIS_PASSWORD=Linea195

# Clave para firmar la sesión del navegador. Genera una propia con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacía, se genera una nueva cada vez que arranca el servidor
# (esto cierra la sesión de todos los usuarios en cada reinicio).
SECRET_KEY=

# Ruta del Excel fuente. Por defecto usa datos/datos.xlsx dentro del proyecto.
ARCHIVO_EXCEL=

# "1" activa el modo debug de Flask (recarga automática, más detalle de error).
# NUNCA lo actives en un servidor expuesto a internet.
FLASK_DEBUG=0

# Nivel de registro: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Host y puerto donde escucha el servidor de desarrollo (python app.py).
HOST=127.0.0.1
PORT=5000
